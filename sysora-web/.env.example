# Copy to .env.local and fill in the secrets.
# .env.local is gitignored — never commit real keys.

# ---- Supabase ----------------------------------------------
# These two are safe to expose; they're already public.
NEXT_PUBLIC_SUPABASE_URL=https://xulhgkrsqpodlokzpbig.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Xg9OFhxHzbTkbSpKUMLq5g_2FIDpmKA

# Server only. Dashboard → Project Settings → API → service_role.
# Bypasses RLS, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe ------------------------------------------------
# Dashboard → Developers → API keys. Test keys (pk_test_/sk_test_)
# are enough to exercise the whole flow.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Dashboard → Developers → Webhooks → your endpoint → signing secret.
# Locally: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ---- Site --------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# With no Stripe keys set, checkout runs in simulation mode: the
# payment step completes without charging, so the rest of the flow
# stays testable. Never set this to true in production.
ALLOW_SIMULATED_PAYMENTS=true

# ---- GoHighLevel ------------------------------------------
# Inbound-webhook trigger for the abandoned-cart workflow. The trigger
# id is in the path, so this URL is a credential: it is the only thing
# authenticating the call.
GHL_ABANDONED_CART_WEBHOOK_URL=

# Minutes after the details step before a cart counts as abandoned.
# Defaults to 30 when unset.
ABANDONED_CART_GRACE_MINUTES=30

# Shared secret for /api/cron/abandoned-carts, sent as
# `Authorization: Bearer <secret>`. pg_cron in Supabase holds the other
# copy. Generate with: openssl rand -hex 32
CRON_SECRET=
